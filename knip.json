{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": ["make", "helm"],
  "workspaces": {
    ".": {
      "entry": ["bin/krun.js", "test/**/*.test.ts", "scripts/gen-crd.ts"],
      "project": ["bin/**/*.js", "test/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/shared": {
      "ignoreBinaries": ["openssl"],
      "entry": ["src/store/migrate.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/validate.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/sdk-node": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/*": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
