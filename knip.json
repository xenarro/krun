{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": ["make", "helm", "helm-docs", "kubectl"],
  "workspaces": {
    ".": {
      "ignoreBinaries": ["promtool"],
      "entry": [
        "bin/krun.js",
        "test/e2e/cluster.ts",
        "test/sdk-conformance/runner.ts",
        "test/sdk-conformance/fixture-node.ts",
        "test/e2e/functions/large_result.ts",
        "test/**/*.test.ts",
        "scripts/gen-crd.ts",
        "scripts/gen-helm-docs.ts",
        "scripts/gen-openapi.ts",
        "scripts/smoke-validate.ts",
        "scripts/smoke-gateway.ts",
        "scripts/bench.ts",
        "scripts/quickstart.ts",
        "test/e2e/quickstart.ts"
      ],
      "project": ["bin/**/*.js", "test/**/*.ts", "scripts/**/*.ts"],
      "vitest": { "config": ["vitest.config.ts", "test/e2e/vitest.config.ts"] }
    },
    "packages/shared": {
      "ignoreBinaries": ["openssl"],
      "entry": ["src/store/migrate.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/main.ts", "src/validate.ts", "src/init.ts", "src/deploy.ts"],
      "project": ["src/**/*.ts"]
    },
    "sdk/node": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "site": {
      "entry": [
        "scripts/sync-docs.ts",
        "scripts/check-links.ts",
        "src/routes/*.ts",
        "src/route-middleware.ts",
        "src/components/overrides/*.astro",
        "src/content/docs/**/*.mdx"
      ],
      "project": ["*.{mjs,ts}", "scripts/**/*.ts", "src/**/*.{astro,ts,mdx}"]
    },
    "apps/*": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "dev/**/*.ts"]
    }
  }
}
