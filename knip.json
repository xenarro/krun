{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": ["make", "helm", "helm-docs", "kubectl"],
  "workspaces": {
    ".": {
      "entry": [
        "bin/krun.js",
        "test/e2e/cluster.ts",
        "test/e2e/functions/large_result.ts",
        "test/**/*.test.ts",
        "scripts/gen-crd.ts",
        "scripts/gen-helm-docs.ts",
        "scripts/gen-openapi.ts",
        "scripts/smoke-validate.ts",
        "scripts/smoke-gateway.ts"
      ],
      "project": ["bin/**/*.js", "test/**/*.ts", "scripts/**/*.ts"],
      "vitest": { "config": ["vitest.config.ts", "test/e2e/vitest.config.ts"] }
    },
    "packages/shared": {
      "ignoreBinaries": ["openssl"],
      "entry": ["src/store/migrate.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/validate.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/sdk-node": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/*": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "dev/**/*.ts"]
    }
  }
}
