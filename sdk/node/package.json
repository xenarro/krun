{
  "name": "@krun/sdk",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenarro/krun.git",
    "directory": "sdk/node"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-sdk-cjs.ts",
    "test": "vitest run",
    "lint": "biome check . && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "vitest": "^5.0"
  }
}
