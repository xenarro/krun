---
/**
 * The 404 page: a left-aligned heading, the known stops, and a void ticket
 * whose route line runs out before its last station.
 */
import Mark from "../../../docs/assets/mark.svg";
import Lost from "./Lost.astro";

const { data } = Astro.locals.starlightRoute.entry;
const title = data.hero?.title ?? data.title;
const tagline = data.hero?.tagline ?? data.description ?? "";
---

<section class="k-404 not-content" aria-labelledby="_top">
  <div class="k-404__copy">
    <p class="k-404__eyebrow">Error 404 · no such stop</p>
    <h1 id="_top" data-page-title class="k-404__title" set:html={title} />
    <p class="k-404__lede" set:html={tagline} />
    <Lost />
  </div>

  <div class="k-void" aria-hidden="true">
    <div class="k-void__head">
      <span class="k-void__brand"><Mark width={20} height={20} /> Run ticket</span>
      <span class="k-void__code">404</span>
    </div>
    <div class="k-void__route">
      <span class="k-void__stop"></span>
      <span class="k-void__stop"></span>
      <span class="k-void__stop k-void__stop--missing"></span>
    </div>
    <dl class="k-void__fields">
      <div><dt>From</dt><dd>a link</dd></div>
      <div><dt>To</dt><dd>nowhere</dd></div>
    </dl>
    <span class="k-void__stamp">Void</span>
  </div>
</section>

<style>
  .k-404 {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(1rem, 4vw, 3.5rem) clamp(1rem, 3vw, 2rem);
  }

  .k-404__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--k-font-mono);
    font-size: var(--k-step--2);
    font-weight: 700;
    letter-spacing: var(--k-tracking-label);
    text-transform: uppercase;
    color: var(--k-accent);
  }

  .k-404__title {
    margin: 0;
    font-size: clamp(2.75rem, 1.6rem + 5vw, 5.25rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--k-text-strong);
  }

  .k-404__lede {
    max-width: 34rem;
    margin: 1.25rem 0 2rem;
    font-size: var(--k-step-1);
    line-height: 1.55;
    color: var(--k-text-muted);
    text-wrap: pretty;
  }

  /* The void ticket */
  .k-void {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem 1.6rem 1.75rem;
    border: 2px dashed var(--k-line-strong);
    border-radius: var(--k-radius-l);
    background: var(--k-bg-raised);
    transform: rotate(2deg);
    -webkit-mask:
      radial-gradient(circle var(--k-notch) at 0 62%, #0000 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--k-notch) at 100% 62%, #0000 97%, #000) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle var(--k-notch) at 0 62%, #0000 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--k-notch) at 100% 62%, #0000 97%, #000) right / 51% 100% no-repeat;
  }

  .k-void__head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .k-void__brand,
  .k-void__fields dt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--k-font-mono);
    font-size: var(--k-step--2);
    font-weight: 600;
    letter-spacing: var(--k-tracking-label);
    text-transform: uppercase;
    color: var(--k-text-muted);
  }

  .k-void__code {
    font-size: clamp(3.5rem, 2rem + 4vw, 5.5rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--k-text-strong);
  }

  /* Two stations on a solid line, then the line breaks into dashes before a
     station that is not there. */
  .k-void__route {
    --dot: 1.1rem;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: center;
    height: var(--dot);
  }

  .k-void__route::before,
  .k-void__route::after {
    content: "";
    position: absolute;
    top: calc(50% - var(--k-route) / 2);
    height: var(--k-route);
    border-radius: var(--k-radius-pill);
  }

  .k-void__route::before {
    left: 0;
    width: 50%;
    background: var(--k-signal);
  }

  .k-void__route::after {
    left: 50%;
    right: var(--dot);
    background: repeating-linear-gradient(90deg, var(--k-line-strong) 0 0.55rem, transparent 0.55rem 1rem);
  }

  .k-void__stop {
    position: relative;
    z-index: 1;
    width: var(--dot);
    height: var(--dot);
    box-sizing: border-box;
    border-radius: 50%;
    border: 0.25rem solid var(--k-signal);
    background: var(--k-bg-raised);
  }

  .k-void__stop--missing {
    border: 0.2rem dashed var(--k-text-muted);
  }

  .k-void__fields {
    display: flex;
    gap: 2.5rem;
    margin: 0;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--k-line-strong);
  }

  .k-void__fields div {
    display: grid;
    gap: 0.15rem;
  }

  .k-void__fields dd {
    margin: 0;
    font-family: var(--k-font-mono);
    font-size: var(--k-step--1);
    font-weight: 600;
    color: var(--k-text-strong);
  }

  .k-void__stamp {
    position: absolute;
    right: 1.4rem;
    bottom: 1.3rem;
    padding: 0.3rem 0.7rem;
    border: 3px solid var(--k-state-failed);
    border-radius: var(--k-radius-s);
    font-family: var(--k-font-mono);
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--k-state-failed);
    transform: rotate(-10deg);
  }

  @media (max-width: 50rem) {
    .k-404 {
      grid-template-columns: minmax(0, 1fr);
    }
    .k-void {
      max-width: 22rem;
      transform: rotate(1.2deg);
    }
  }
</style>
