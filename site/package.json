{
  "name": "@krun/site",
  "version": "0.0.0",
  "private": true,
  "description": "krun documentation and microsite, published to GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node scripts/sync-docs.ts && astro dev",
    "preview": "astro preview",
    "site:build": "node scripts/sync-docs.ts && astro build",
    "site:links": "node scripts/check-links.ts",
    "site:check": "pnpm run site:build && pnpm run site:links"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42",
    "astro": "^7.4",
    "vitest": "^5.0"
  }
}
